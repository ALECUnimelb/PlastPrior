  "record_assembly_policy": {
    "version": "source-record-assembly-v1",
    "missing_tokens": [
      "",
      "#N/A",
      "#N/A N/A",
      "#NA",
      "-1.#IND",
      "-1.#QNAN",
      "-NaN",
      "-nan",
      "1.#IND",
      "1.#QNAN",
      "<NA>",
      "N/A",
      "NA",
      "NULL",
      "NaN",
      "None",
      "n/a",
      "nan",
      "null"
    ],
    "missing_value_rule": "For availability and selection only, trim whitespace and compare case-sensitively with the declared tokens; preserve source values in the record export.",
    "inclusion_rule": "Retain all candidate inventory rows. Only MPLEACH requires both reported InChIKey and SMILES, following the historical source-selection rule. Excluded rows remain in the output."
  }
